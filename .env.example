# Copy to .env; never commit real credentials.
GEMINI_API_KEY=
# Demo role sign-in is enabled for local showcases; set false with APPROVAL_TOKEN in shared deployments.
DEMO_MODE=true
APPROVAL_TOKEN=
APP_SESSION_SECRET=
AUTO_RUN_INTERVAL_HOURS=24
AGE_THRESHOLD_DAYS=120
DATA_DIR=./data
PORT=3000
FASTAPI_URL=http://127.0.0.1:8000
